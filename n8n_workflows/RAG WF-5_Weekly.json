      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(SUM(total_tokens), 0) as total_tokens FROM llm_usage_log WHERE created_at >= NOW() - INTERVAL '7 days' AND created_at < NOW();",
