          "id": "5PaPhRZOm9a74RNi",
          "name": "Postgres RAG account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO stats_aggregates (client_id, period_type, period_start, period_end, total_queries, total_tokens, top_queries_json) VALUES ('default', 'week', $1, $2, $3, $4, $5::jsonb);",
        "options": {
          "queryReplacement": "={{ [new Date(Date.now() - 7*24*60*60*1000).toISOString().split('T')[0], new Date().toISOString().split('T')[0], $('Format Messages').first().json.count, $('Fetch Tokens').first().json.total_tokens, JSON.stringify($('Parse LLM').first().json.topQueries)] }}"
        }
