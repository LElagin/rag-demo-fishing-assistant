          "name": "Postgres RAG account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst queries = items.map(item => item.json.content).filter(Boolean);\nconst count = queries.length;\nconst text = queries.join('\\n');\n\nconst messages = [\n  {\n    role: 'system',\n    content: 'Ты — аналитик. Проанализируй список вопросов покупателей. Сгруппируй их по смыслу и выдели ТОП-10 самых частых тем. Верни СТРОГО JSON-массив формата: [{\"theme\": \"Тема\", \"count\": N}, ...]. Не добавляй никакой текст кроме JSON.'\n  },\n  {\n    role: 'user',\n    content: text\n  }\n];\n\nreturn [{ json: { count, messages } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        256
      ],
      "id": "e50d502c-a046-4d7a-8956-ea0b7e80dce2",
      "name": "Format Messages"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://foundation-models.api.cloud.ru/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "ai-sage/GigaChat3-10B-A1.8B"
            },
            {
              "name": "messages",
              "value": "={{ $json.messages }}"
            },
            {
              "name": "temperature",
              "value": "0"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2384,
        256
      ],
      "id": "9653016c-f90a-4e1b-b450-2972c45fcff2",
      "name": "LLM Grouping",
      "credentials": {
        "httpHeaderAuth": {
          "id": "9HsopcS7bFxNghFw",
          "name": "Header Auth RAG"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nlet content = resp.choices[0].message.content;\ncontent = content.replace(/```json/g, '').replace(/```/g, '').trim();\nlet topQueries = [];\ntry {\n  topQueries = JSON.parse(content);\n} catch (e) {\n  topQueries = [];\n}\nreturn [{ json: { topQueries } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2624,
        256
      ],
      "id": "1edc6018-7dc5-495f-9397-fa17c1c318a6",
      "name": "Parse LLM"
    },
