    {
      "parameters": {
        "jsCode": "const spent = Number($input.first().json.total_tokens_spent) || 0;\nconst budget = Number($('Set').first().json.dailyBudgetTokens) || 0;\nconst isExceeded = spent >= budget;\n\nconst htmlBody = `\n  <h2 style=\"color: #f57c00;\">⚠️ ВНИМАНИЕ: Расход токенов</h2>\n  <p>Система RAG-ассистента приближается к установленному лимиту или превысила его.</p>\n  <table style=\"border-collapse: collapse; width: 100%; margin: 15px 0;\">\n    <tr style=\"background: #f5f5f5;\">\n      <th style=\"padding: 8px; text-align: left;\">Потрачено за 24ч:</th>\n      <td style=\"padding: 8px; font-weight: bold; color: ${isExceeded ? '#d32f2f' : '#388e3c'};\">${spent} токенов</td>\n    </tr>\n    <tr>\n      <th style=\"padding: 8px; text-align: left;\">Установленный порог:</th>\n      <td style=\"padding: 8px;\">${budget} токенов</td>\n    </tr>\n  </table>\n  <p><strong>Рекомендация:</strong> проверьте баланс API-ключа и при необходимости пополните счет.</p>\n  <hr>\n  <p style=\"color: #666; font-size: 12px;\">Система мониторинга WF-3B</p>\n`;\n\nreturn [{\n  json: {\n    isExceeded: isExceeded,\n    subject: `⚠️ ЛИМИТ ТОКЕНОВ: Потрачено ${spent} из ${budget}`,\n    htmlBody: htmlBody\n  }\n}];;"
      },
