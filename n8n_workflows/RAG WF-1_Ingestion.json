    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.data || $input.first().json;\n\nif (!rawText || rawText.trim().length === 0) {\n  throw new Error('Файл пуст или не удалось прочитать');\n}\n\n// Разбиваем на строки и пропускаем заголовок (первую строку)\nconst lines = rawText.trim().split('\\n');\nconst dataLines = lines.slice(1);\nconst documents = [];\n\nfor (let i = 0; i < dataLines.length; i++) {\n  const line = dataLines[i].trim();\n  if (!line) continue;\n  \n  // Разбиваем по запятой (CSV формат)\n  const cols = line.split(',');\n  \n  // Проверяем, что в строке есть все необходимые колонки\n  if (cols.length >= 7) {\n    const sku = cols[0].trim();\n    const name = cols[1].trim();\n    const brand = cols[2].trim();\n    const category = cols[3].trim();\n    const price = cols[4].trim();\n    const stock = cols[5].trim();\n    const unit = cols[6].trim();\n\n    // Формируем идеальный для LLM однострочный текст\n    const text = `Артикул (SKU): ${sku}. Наименование: ${name}. Бренд: ${brand}. Категория: ${category}. Цена: ${price} рублей. Остаток на складе: ${stock} ${unit}.`;\n\n    documents.push({\n      json: {\n        text: text,\n        metadata: {\n          source: 'Price_fishing.csv',\n          sku: sku,\n          category: category,\n          brand: brand,\n          price: parseFloat(price),\n          row_index: i\n        }\n      }\n    });\n  }\n}\n\nreturn documents;"
      },
