        "query": "SELECT content FROM chat_messages WHERE role = 'user' AND client_id = 'default' AND created_at >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '1 month') AND created_at < DATE_TRUNC('month', CURRENT_DATE);",
        "options": {}
