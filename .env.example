# n8n Settings
N8N_HOST=rag.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_BASE_URL=https://rag.yourdomain.com
N8N_ENCRYPTION_KEY=your-32-char-hex-key-here

# PostgreSQL
POSTGRES_USER=rag
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ragdb

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=your-tunnel-id-here
